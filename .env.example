# Copy this file to .env.local for local development.
#
# Choose one provider setup. The app checks these in this order:
# proxy -> ollama -> OpenAI-compatible -> OpenAI.

# Option 1: local Ollama, no per-call API charge.
# Install/run Ollama separately, then pull a model such as llama3.1.
# VITE_LLM_PROVIDER=ollama
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_LLM_MODEL=llama3.1

# Option 2: any OpenAI-compatible API.
# Some local servers and hosted providers expose /v1/chat/completions.
# VITE_LLM_PROVIDER=compatible
# VITE_LLM_BASE_URL=http://localhost:1234/v1
# VITE_LLM_MODEL=your-model-name
# VITE_LLM_API_KEY=optional-key-if-needed

# Option 3: custom backend/serverless proxy.
# Recommended for deployed builds because secrets stay server-side.
# VITE_LLM_PROVIDER=proxy
# VITE_LLM_PROXY_URL=https://your-api.example.com/generate-weapon
#
# Cloudflare Workers AI local dev example:
# VITE_LLM_PROXY_URL=http://localhost:8787/generate-weapon

# Option 4: OpenAI direct browser call, local development only.
# Browser-exposed keys are visible to users, so do not deploy this.
# VITE_LLM_PROVIDER=openai
# VITE_OPENAI_API_KEY=sk-your-key-here
# VITE_LLM_MODEL=gpt-4o-mini
